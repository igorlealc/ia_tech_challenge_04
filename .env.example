# Azure Speech: chave e região do mesmo recurso.
SPEECH_KEY=
SPEECH_REGION=

# Azure Language / Text Analytics: endpoint e chave do mesmo recurso.
# Exemplo de endpoint: https://seu-recurso.cognitiveservices.azure.com/
TEXT_ANALYTICS_ENDPOINT=
TEXT_ANALYTICS_KEY=

# Azure Translator: tradução posterior à transcrição no avaliar_audio.py.
# transcrever_audio.py usa Speech Translation com SPEECH_KEY e SPEECH_REGION.
TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
TRANSLATOR_KEY=
# Região obrigatória para recursos regionais ou de múltiplos serviços.
TRANSLATOR_REGION=

# SMTP autenticado. Use a senha de aplicativo quando o provedor exigir.
SMTP_HOST=
SMTP_PORT=587
# starttls (normalmente 587) ou ssl (normalmente 465).
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Um único destinatário, somente o endereço (sem nome de exibição).
EMAIL_TO=
SMTP_TIMEOUT=30
